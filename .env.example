# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=family_financial
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码可留空
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- JWT（长度建议不少于 32 字符）----------
JWT_SIGN_KEY=please-change-this-to-a-32-byte-or-longer-secret

# ---------- 日志目录（仅 active profile 写文件，默认 logs/）----------
# LOG_PATH=logs

# ---------- CORS ----------
# 多个来源用英文逗号分隔；本地调试可用 *
CORS_ALLOWED_ORIGINS=*

# ---------- 阿里云 OSS（头像等文件；不配则上传接口会失败）----------
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
# 可选。配置后文件 URL 使用该域名
ALIYUN_OSS_CUSTOM_DOMAIN=
# 例如 test/uploads/ 或 prod/uploads/
ALIYUN_OSS_FOLDER=test/uploads/

# ---------- 智谱 AI（语音记账解析、账单分类；不配则相关接口会失败）----------
ZHIPU_AI_API_KEY=
ZHIPU_AI_MODEL=glm-4-flash

# ---------- 阿里云短信（仅 production / active profile）----------
# test profile 固定关闭短信，验证码直接返回前端，可不填下面几项
SMS_ENABLE=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
